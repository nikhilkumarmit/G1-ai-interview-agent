# ── Groq API ──────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Models (free-tier on Groq) ───────────────────────────────
STT_MODEL=whisper-large-v3-turbo
TTS_MODEL=playai-tts
TTS_VOICE=Fritz-PlayAI
LLM_MODEL=openai/gpt-oss-120b

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Interview settings ──────────────────────────────────────
QUESTION_BUDGET=12
TIME_LIMIT_SECONDS=1800

# ── Data persistence ─────────────────────────────────────────
DATA_DIR=./data

# ── Chroma DB (Cloud / Remote) ──────────────────────────────
# Set CHROMA_API_KEY from https://trychroma.com/ to use Chroma Cloud
CHROMA_USE_CLOUD=true
CHROMA_API_KEY=your_chroma_api_key_here
CHROMA_TENANT=default_tenant
CHROMA_DATABASE=default_database
CHROMA_CLOUD_HOST=api.trychroma.com
CHROMA_COLLECTION=interview_chunks

